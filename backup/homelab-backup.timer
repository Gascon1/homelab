# Template: backup/install.sh replaces @TZ@ with TZ from .env and installs this
# file to /etc/systemd/system/. Do not copy it by hand.
[Unit]
Description=Nightly Immich photo backup to the backup Pi

[Timer]
# After Immich's own database dump (02:00 in the stack's TZ by default), so the
# night's dump is in the snapshot. The host clock is UTC, hence the explicit zone.
OnCalendar=*-*-* 04:30 @TZ@
RandomizedDelaySec=15min
# Runs at boot if the server was off at 04:30
Persistent=true
Unit=homelab-backup.service

[Install]
WantedBy=timers.target
