# Backup config for backup/backup.sh. install.sh copies this to /etc/homelab-backup.env
# (root, mode 600) if it is missing. Plain KEY=VALUE lines; the file is parsed, not sourced.
# The restic repository password lives in /etc/homelab-backup.password, not here.

# rest-server on the backup Pi, over the tailnet. <user>/<pass> are from the Pi's
# htpasswd file. The path must be /<user>/ because the Pi runs --private-repos.
# Generate the password with: openssl rand -hex 24 (hex, so it needs no URL escaping)
RESTIC_REPOSITORY=rest:http://homelab:CHANGE_ME@backup-pi:8000/homelab/

# Folder to back up. install.sh fills this in from UPLOAD_LOCATION in .env.
# thumbs/ and encoded-video/ under it are skipped (Immich rebuilds them).
BACKUP_ROOT=

# Partial integrity check: how often, and how much pack data to download and verify
CHECK_EVERY_DAYS=30
CHECK_SUBSET=2G
