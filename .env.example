# =============================================================================
# Homelab Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your system.
# Run `id` to find your PUID and PGID values.

# User/Group IDs - must match your system user for correct file permissions
PUID=1000
PGID=1000

# Timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/Toronto

# =============================================================================
# Paths
# =============================================================================

# Container configuration storage (relative to compose.yml)
APPDATA=./appdata

# Media and downloads root (external drive recommended)
DATA_DIR=/srv/data

# Server IP or hostname (advertised to Plex clients)

# Address web UIs are published on. Set to your LAN IP (e.g. 192.168.1.10) so
# services are not published on every interface. Docker-published ports bypass
# ufw, so this is the reliable way to limit exposure. Default: all interfaces.
# Plex and the qBittorrent torrent ports always stay on all interfaces.
BIND_ADDR=0.0.0.0

# =============================================================================
# Immich (Photo Management)
# =============================================================================

# Immich version - use 'release' for latest stable
IMMICH_VERSION=release

# Photo/video upload storage (under your media tree)
UPLOAD_LOCATION=/srv/data/media/photos

# PostgreSQL database storage (keep on local disk, not network share)
DB_DATA_LOCATION=./appdata/immich/postgres

# Database credentials (alphanumeric password only)
DB_PASSWORD=change-me-to-a-secure-password
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# =============================================================================
# Rack (Dashboard) - all optional
# =============================================================================

# Immich API key: Immich > Account Settings > API Keys > New API Key
RACK_IMMICH_API_KEY=

# qBittorrent Web UI login: Tools > Options > Web UI > Authentication
RACK_QBITTORRENT_USERNAME=
RACK_QBITTORRENT_PASSWORD=

# Normally discovered automatically from each app's config; set only to override
# RACK_PLEX_TOKEN=
# RACK_SONARR_API_KEY=
# RACK_RADARR_API_KEY=
# RACK_PROWLARR_API_KEY=
# RACK_SEERR_API_KEY=

# =============================================================================
# Remote access (optional): Tailscale + Caddy. See docs/remote-access/
# =============================================================================

# Uncomment so every docker compose command also runs tailscale and caddy
# COMPOSE_PROFILES=remote

# Tailscale auth key (admin console > Settings > Keys > Generate auth key).
# Use a one-off, pre-approved key tagged tag:homelab. It is only needed for the
# first start: delete it from here afterwards (login is kept in ${APPDATA}/tailscale)
# and run `docker compose up -d` so the container is recreated without it. Until then
# anything with the Docker socket (Rack, Netdata) can read it via `docker inspect`.
TS_AUTHKEY=

# Machine name on your tailnet, and your tailnet DNS name (admin console > DNS,
# looks like tail1234.ts.net). Services are then at https://homelab.tail1234.ts.net:<port>
TS_HOSTNAME=homelab
TS_TAILNET=tailnet-name.ts.net

# Extra flags for `tailscale up` (usually empty). With TS_AUTH_ONCE they only apply
# at first login; later changes need `docker compose exec tailscale tailscale set ...`
TS_EXTRA_ARGS=
