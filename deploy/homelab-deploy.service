# Template: deploy/install.sh replaces the @...@ placeholders and installs this
# file to /etc/systemd/system/. Do not copy it by hand.
[Unit]
Description=Homelab pull-based deploy (see docs/deploy.md)
Documentation=file://@REPO_DIR@/docs/deploy.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=@DEPLOY_USER@
WorkingDirectory=@REPO_DIR@
# Both files are optional; scripts/deploy.sh reads the first one it finds.
EnvironmentFile=-/etc/homelab-deploy.env
EnvironmentFile=-@REPO_DIR@/deploy/deploy.env
Environment=REPO_DIR=@REPO_DIR@
ExecStart=@REPO_DIR@/scripts/deploy.sh
TimeoutStartSec=20min
SyslogIdentifier=homelab-deploy

# Hardening. The unit talks to Docker through /var/run/docker.sock with the
# group rights of @DEPLOY_USER@ (docker group). None of the options below block that.
# Note: docker group access is root-equivalent; this limits the script, not Docker.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# "read-only" (not "yes") so a repo under /home still works; the repo is made writable below.
ProtectHome=read-only
ReadWritePaths=@REPO_DIR@
# docker compose build (RACK_SOURCE=build) writes buildx state here; "-" ignores a missing path
ReadWritePaths=-@USER_HOME@/.docker
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
