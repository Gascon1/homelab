# Deploy config for scripts/deploy.sh. install.sh copies this to deploy/deploy.env
# (gitignored) if it is missing. Plain KEY=VALUE lines; the file is parsed, not sourced.
# Alternative location: /etc/homelab-deploy.env (read first when it exists).

# Repo checkout on the server (install.sh also sets this in the unit)
# REPO_DIR=/home/you/homelab

# Branch and remote to follow
BRANCH=main
# REMOTE=origin

# GitHub repo used for the release check
GITHUB_REPO=Gascon1/homelab

# Optional. Needed only if the repo is private (fine-grained token, read-only
# Checks + Contents + Metadata on this repo). Also raises the 60 requests/hour limit.
# GITHUB_TOKEN=

# registry: pull the rack image from GHCR (default).
# build: build the rack image on this server (use if the image or repo is private).
RACK_SOURCE=registry

# 1: after a good deploy, remove rack images older than a week that no container uses.
PRUNE=1

# Passed to docker compose. Leave unset if COMPOSE_PROFILES is already in .env.
# COMPOSE_PROFILES=remote

# Where the skip file and lock live (default: <repo>/.deploy-state)
# STATE_DIR=
